{
  "name": "@figtreejs/examples",
  "private": true,
  "type": "module",
  "version": "0.0.1-beta.5",
  "scripts": {
    "build": "observable build",
    "clean": "rimraf src/.observablehq/cache",
    "deploy": "observable deploy",
    "dev": " rimraf src/.observablehq/cache/_node/@figtreejs && observable preview",
